# Dependencies — Cloudflare installs these itself from package.json during
# the build. Committing them would add tens of thousands of files to the
# repo, make every push slow, and can actually break the build, since the
# platform-specific binaries installed on a Mac are not the ones a Linux
# build server needs.
node_modules/

# Build output — regenerated by `npm run build` on every deploy.
dist/

# Local env files. Nothing secret lives here today, but this is the file
# that quietly leaks keys later if it isn't ignored from the start.
.env
.env.local
.env.*.local

# Editor / OS noise
.DS_Store
.vscode/
.idea/
*.log
npm-debug.log*
